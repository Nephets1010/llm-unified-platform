{
  "dashboard": {
    "title": "LLM Platform - Gateway Overview",
    "uid": "llm-gateway-overview",
    "tags": ["llm-platform", "gateway"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "QPS",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(llm_requests_total[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "reqps", "min": 0},
          "overrides": []
        }
      },
      {
        "id": 2,
        "title": "P95 Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(llm_request_latency_seconds_bucket[5m])) by (le, model))",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "s", "min": 0},
          "overrides": []
        }
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(llm_errors_total[5m])) by (error_code)",
            "legendFormat": "{{error_code}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "short", "min": 0},
          "overrides": []
        }
      },
      {
        "id": 4,
        "title": "First Token Latency P95",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(llm_first_token_latency_seconds_bucket[5m])) by (le, model))",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "s", "min": 0},
          "overrides": []
        }
      },
      {
        "id": 5,
        "title": "Token Usage",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(llm_tokens_total[5m])) by (model, type)",
            "legendFormat": "{{model}} - {{type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "short", "min": 0},
          "overrides": []
        }
      },
      {
        "id": 6,
        "title": "Rate Limited",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(llm_rate_limited_total[5m])) by (dimension)",
            "legendFormat": "{{dimension}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "short", "min": 0},
          "overrides": []
        }
      }
    ],
    "refresh": "10s",
    "time": {"from": "now-1h", "to": "now"}
  }
}
