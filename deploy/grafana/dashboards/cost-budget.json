{
  "dashboard": {
    "title": "LLM Platform - Cost & Budget",
    "uid": "llm-cost-budget",
    "tags": ["llm-platform", "cost", "budget"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Cost by Model (rate)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(llm_cost_usd_total[5m])) by (model)",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "currencyUSD", "min": 0},
          "overrides": []
        }
      },
      {
        "id": 2,
        "title": "Budget Used Ratio",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "llm_budget_used_ratio",
            "legendFormat": "{{tenant}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1.5,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.8},
                {"color": "red", "value": 1.0}
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "title": "Budget Alerts",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(llm_budget_alerts_total[5m])) by (tenant, level)",
            "legendFormat": "{{tenant}} - {{level}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "short", "min": 0},
          "overrides": []
        }
      },
      {
        "id": 4,
        "title": "Cumulative Cost by Tenant",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sum(llm_cost_usd_total) by (tenant)",
            "legendFormat": "{{tenant}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "currencyUSD", "min": 0},
          "overrides": []
        }
      }
    ],
    "refresh": "30s",
    "time": {"from": "now-24h", "to": "now"}
  }
}
