# =============================================================
# 大模型统一接入与能力评估中台 — 环境变量模板
# 复制为 .env 并填入真实值；严禁把 .env 提交到仓库（gitleaks 把关）
# =============================================================

# --- 基础 ---
LLM_ENVIRONMENT=dev
LLM_DEBUG=false

# --- 存储 ---
LLM_DATABASE_URL=postgresql+psycopg://llm:llm_dev_pw@localhost:5432/llm_platform
LLM_REDIS_URL=redis://localhost:6379/0

# --- 安全（生产必须替换真值） ---
LLM_JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
LLM_JWT_EXPIRE_MINUTES=60
LLM_DEFAULT_ADMIN_KEY=sk-admin-demo-key-change-me

# --- 上游厂商密钥（仅通过环境变量注入，禁止硬编码） ---
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_QWEN_API_KEY=
LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_OLLAMA_BASE_URL=http://localhost:11434

# --- 网关行为 ---
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_DEFAULT_MONTHLY_BUDGET=1000.0

# --- 限流与预算 ---
LLM_RATE_LIMIT_DEFAULT_RPM=60
LLM_RATE_LIMIT_DEFAULT_TPM=60000
LLM_BUDGET_ALERT_RATIO=0.8

# --- 路由 ---
LLM_ROUTING_STRATEGY=health_aware
LLM_ROUTING_FAILOVER_MAX=2
LLM_CIRCUIT_ERROR_RATE_THRESHOLD=0.5
LLM_CIRCUIT_OPEN_SECONDS=30
LLM_CIRCUIT_HALF_OPEN_PROBES=1

# --- 日志 ---
LLM_LOG_LEVEL=INFO
LLM_LOG_SAMPLE_RATE=1.0

# --- 风险阈值 ---
LLM_RISK_BUDGET_BURN_RATIO=0.8
LLM_RISK_P95_LATENCY_MS=5000
LLM_RISK_ERROR_RATE=0.05
